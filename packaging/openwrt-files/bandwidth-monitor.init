#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1

start_service() {
    [ -f /etc/bandwidth-monitor/env ] && . /etc/bandwidth-monitor/env

    procd_open_instance
    procd_set_param command /usr/bin/bandwidth-monitor
    procd_set_param env \
        ADGUARD_PASS="${ADGUARD_PASS:-}" \
        ADGUARD_URL="${ADGUARD_URL:-}" \
        ADGUARD_USER="${ADGUARD_USER:-}" \
        APNS_BUNDLE_ID="${APNS_BUNDLE_ID:-}" \
        APNS_ENV="${APNS_ENV:-production}" \
        APNS_KEY_FILE="${APNS_KEY_FILE:-}" \
        APNS_KEY_ID="${APNS_KEY_ID:-}" \
        APNS_PUSH_INTERVAL="${APNS_PUSH_INTERVAL:-10s}" \
        APNS_TEAM_ID="${APNS_TEAM_ID:-}" \
        DEBUG_HTTP_LOG="${DEBUG_HTTP_LOG:-false}" \
        GEO_ASN="${GEO_ASN:-/etc/bandwidth-monitor/GeoLite2-ASN.mmdb}" \
        GEO_CITY="${GEO_CITY:-${GEO_COUNTRY:-/etc/bandwidth-monitor/GeoLite2-City.mmdb}}" \
        GEO_COUNTRY="${GEO_COUNTRY:-}" \
        INTERFACES="${INTERFACES:-}" \
        LATENCY_MONITORING="${LATENCY_MONITORING:-true}" \
        LATENCY_TARGETS="${LATENCY_TARGETS:-}" \
        LISTEN="${LISTEN:-:8080}" \
        LISTEN_PROTOCOL="${LISTEN_PROTOCOL:-http}" \
        LOCAL_NETS="${LOCAL_NETS:-}" \
        NEXTDNS_API_KEY="${NEXTDNS_API_KEY:-}" \
        NEXTDNS_PROFILE="${NEXTDNS_PROFILE:-}" \
        OMADA_PASS="${OMADA_PASS:-}" \
        OMADA_SITE="${OMADA_SITE:-Default}" \
        OMADA_URL="${OMADA_URL:-}" \
        OMADA_USER="${OMADA_USER:-}" \
        PIHOLE_PASSWORD="${PIHOLE_PASSWORD:-}" \
        PIHOLE_URL="${PIHOLE_URL:-}" \
        PROMISCUOUS="${PROMISCUOUS:-true}" \
        SPAN_DEVICE="${SPAN_DEVICE:-}" \
        SPEEDTEST_SERVER="${SPEEDTEST_SERVER:-}" \
        TLS_CERT_FILE="${TLS_CERT_FILE:-}" \
        TLS_KEY_FILE="${TLS_KEY_FILE:-}" \
        UNIFI_PASS="${UNIFI_PASS:-}" \
        UNIFI_SITE="${UNIFI_SITE:-default}" \
        UNIFI_URL="${UNIFI_URL:-}" \
        UNIFI_USER="${UNIFI_USER:-}" \
        VPN_STATUS_FILES="${VPN_STATUS_FILES:-}" \
        WAN_INTERFACE="${WAN_INTERFACE:-}"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
